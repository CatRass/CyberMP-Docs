{
  "compilerOptions": {
    "target": "es2019",
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": false,
    "noImplicitAny": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
  },
  "include": [
    "./node_modules/@cybermp/**/*"
  ],
}
